{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "TFT Comps Overlay",
    "author": "Elton Miranda",
    "version": "0.1.0",
    "minimum-overwolf-version": "0.311.0.6",
    "description": "App pessoal em desenvolvimento: grava dados do TFT (GEP) para analise e mostra o overlay de comps. Nao e afiliado a Riot Games.",
    "icon": "assets/icon.png"
  },
  "permissions": ["GameInfo", "FileSystem"],
  "data": {
    "start_window": "background",
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [28164, 28162]
    },
    "game_events": [28164, 28162, 21570],
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": { "game_ids": [28164, 28162] },
        "start_minimized": true
      }
    ],
    "windows": {
      "background": {
        "file": "background/background.html",
        "is_background_page": true
      },
      "overlay": {
        "file": "overlay/overlay.html",
        "in_game_only": true,
        "transparent": true,
        "clickthrough": true,
        "ignore_keyboard_events": true,
        "grab_keyboard_focus": false,
        "show_in_taskbar": false,
        "topmost": true,
        "resizable": false,
        "disable_rightclick": true,
        "size": { "width": 340, "height": 300 },
        "start_position": { "top": 96, "left": 24 }
      }
    }
  }
}
